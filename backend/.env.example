# Local overrides for backend/. Root .env and real environment
# variables take precedence (see backend/config.py).
SUPABASE_URL=
# Publishable/anon key used by the HTTP profiles API (per-request clients).
SUPABASE_KEY=
# Privileged service key. Used ONLY by the document worker
# (backend.document_worker); never by HTTP routes or the app.
SUPABASE_SERVICE_KEY=
DATABASE_URL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
REDIS_URL=redis://localhost:6379/0
MAX_UPLOAD_MB=10
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
