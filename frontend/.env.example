# Public values only; never put the Supabase service key in the app.
# Backend base URL.
# Web dev:  EXPO_PUBLIC_API_URL=http://localhost:8000
# Device:   EXPO_PUBLIC_API_URL=http://<your LAN IP>:8000
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
# Supabase project URL and publishable (anon) key, same project as the backend.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
